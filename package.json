{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"php -S 127.0.0.1:8000 -t public public/index.php\" \"php artisan queue:listen --tries=1\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "php -S 127.0.0.1:8000 -t public public/index.php",
    "dev:queue": "php artisan queue:listen --tries=1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.4",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^2.0",
    "tailwindcss": "^4.0.7",
    "vite": "^7.0.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1"
  }
}
